<?xml version="1.0" encoding="utf-8"?>
<!-- A home screen card: the picture of the desk's card, a tap target over all of it, and tap
     targets that the list widget lays over each item (see widget/ArtefactWidgets.kt). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/card_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="yes"
        android:scaleType="fitCenter" />

    <FrameLayout
        android:id="@+id/card_open"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="top|start"
        android:background="@drawable/widget_card_ripple" />

    <!-- The next note (Notes widget, when there is more than one): laid in the card's corner. -->
    <ImageView
        android:id="@+id/card_next"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_gravity="top|start"
        android:background="@drawable/widget_round_button"
        android:padding="8dp"
        android:src="@drawable/widget_next"
        android:tint="#99000000"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/row0"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_gravity="top|start"
        android:background="@drawable/widget_pill_ripple"
        android:visibility="gone" />
    <FrameLayout
        android:id="@+id/row1"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_gravity="top|start"
        android:background="@drawable/widget_pill_ripple"
        android:visibility="gone" />
    <FrameLayout
        android:id="@+id/row2"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_gravity="top|start"
        android:background="@drawable/widget_pill_ripple"
        android:visibility="gone" />
    <FrameLayout
        android:id="@+id/row3"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_gravity="top|start"
        android:background="@drawable/widget_pill_ripple"
        android:visibility="gone" />
    <FrameLayout
        android:id="@+id/row4"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_gravity="top|start"
        android:background="@drawable/widget_pill_ripple"
        android:visibility="gone" />
    <FrameLayout
        android:id="@+id/row5"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_gravity="top|start"
        android:background="@drawable/widget_pill_ripple"
        android:visibility="gone" />
    <FrameLayout
        android:id="@+id/row6"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_gravity="top|start"
        android:background="@drawable/widget_pill_ripple"
        android:visibility="gone" />
    <FrameLayout
        android:id="@+id/row7"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_gravity="top|start"
        android:background="@drawable/widget_pill_ripple"
        android:visibility="gone" />
</FrameLayout>
