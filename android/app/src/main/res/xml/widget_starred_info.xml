<?xml version="1.0" encoding="utf-8"?>
<!-- Opens at 2x3, the desk card's own shape (the list's three items, the Recent card's 226 dp);
     resizable, the card drawn anew for every size. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_starred_description"
    android:initialLayout="@layout/widget_card"
    android:minWidth="110dp"
    android:minHeight="200dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="110dp"
    android:maxResizeWidth="340dp"
    android:maxResizeHeight="420dp"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="2"
    android:targetCellHeight="3"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen" />
